# Rust build output and generated UI review snapshots
/target/

# Python cache files generated by the Hubstaff mock tests
__pycache__/
*.py[cod]

# Local SQLite databases and transient sidecars. Deliberate database fixtures
# are re-included below when they are added under a fixtures directory.
*.db
*.db-wal
*.db-shm
*.db-journal
*.db.lock
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite.lock
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
*.sqlite3.lock

# Rust/LLVM profiling output
*.profraw
*.profdata

# OS and editor-local noise
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
.idea/**/workspace.xml

# Keep deliberately checked-in SQLite fixtures visible.
!**/fixtures/**/*.db
!**/fixtures/**/*.sqlite
!**/fixtures/**/*.sqlite3
